#!/sbin/sh
umask 022
ui_print() { echo "$1"; }
require_root_manager() {
  ui_print "**********************************************"
  ui_print " Please install via Magisk, KernelSU, or APatch! "
  ui_print "**********************************************"
  exit 1
}
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null

UTIL=""
for u in /data/adb/magisk/util_functions.sh /data/adb/ksu/util_functions.sh /data/adb/ap/util_functions.sh; do
  if [ -f "$u" ]; then
    UTIL=$u
    break
  fi
done

[ -n "$UTIL" ] || require_root_manager
. "$UTIL"

[ -n "$MAGISK_VER_CODE" ] && [ "$MAGISK_VER_CODE" -lt 20400 ] && require_root_manager

install_module
exit 0
